---
import ArticleLayout from '../layouts/ArticleLayout.astro'

// 正文为判断层 2026-09-08「官网收缩第二包」第 5 部分定稿，一字不改。
const DATE_MODIFIED = '2026-09-08'

const faq = [
  {
    q: '台词会不会被改？',
    a: '积米律动的台词不经 AI 改写；语音识别的错字可能存在，投稿前请人工核对。',
  },
  {
    q: '要多久？',
    a: '随视频长度和电脑性能变化，任务开始前会显示费用预估。',
  },
]

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
}

const article = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '什么是 AI 拉片？',
  inLanguage: 'zh-CN',
  datePublished: '2026-07-05',
  dateModified: DATE_MODIFIED,
  author: { '@type': 'Organization', name: '积米律动', url: 'https://kimidance.com' },
  publisher: { '@type': 'Organization', name: '积米律动', url: 'https://kimidance.com' },
  mainEntityOfPage: 'https://kimidance.com/what-is-ai-lapian/',
}
---

<ArticleLayout
  title="什么是 AI 拉片？| 积米律动"
  description="拉片是把一部剧逐镜头暂停、记录、分析；AI 拉片把记录性劳动交给机器：输入一部视频，输出文学剧本、叙事节奏分析、分镜速查表。"
  jsonLd={[article, faqPage]}
  dateModified={DATE_MODIFIED}
>
  <div class="label-caps mb-4">Guide</div>
  <h1 class="text-editorial text-3xl sm:text-4xl md:text-5xl font-bold leading-tight mb-8">
    什么是 AI 拉片？
  </h1>

  <p>
    拉片，是把一部剧逐镜头暂停、记录、分析：每个镜头的景别、运镜、剪辑点、台词、表演，最后弄明白"这场戏为什么这么拍"。它是编剧、导演、编导艺考生的基本功，也是最耗时间的基本功——一集短剧手工拉下来，往往要以小时计。
  </p>
  <p>
    AI 拉片，是把这件事交给机器：语音识别抄台词，视觉模型切镜头、认景别和运镜，大语言模型把它们整理成稿。输入一部视频，输出三样东西：文学剧本、叙事节奏分析、分镜速查表。
  </p>
  <p>
    <strong>它替你做的是记录性劳动：切镜、抄台词、整理镜头表、初步标情绪和叙事功能。它替不了的是判断：这个钩子为什么有效，这条情绪曲线好在哪，哪些结构值得学，哪些只是题材红利。</strong>
  </p>

  <h2>用之前该知道的两件事</h2>
  {
    faq.map((f) => (
      <>
        <h3>{f.q}</h3>
        <p>{f.a}</p>
      </>
    ))
  }

  <p class="mt-10">
    想看 AI 拉出来的剧本长什么样 → <a href="/#sample">首页真实产出</a> ｜ 想自己试 → <a href="/download/">下载客户端</a>
  </p>
</ArticleLayout>
