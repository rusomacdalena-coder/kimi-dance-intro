  jsonLd={[softwareApp]}
  dateModified={DATE_MODIFIED}
>
  <div class="label-caps mb-4">Download</div>
  <h1 class="text-editorial text-3xl sm:text-4xl md:text-5xl font-bold leading-tight mb-8">
    下载积米律动客户端
  </h1>

  <p>
    积米律动目前处于<strong>公测期，采用邀请码注册</strong>。macOS 与 Windows 客户端均已开放下载，你可以先<a
      href="/#beta">在首页申请邀请码</a
    >——通过后凭码注册即赠送体验积分。
  </p>

  <!-- 平台下载卡片 -->
  <div class="grid gap-4 sm:grid-cols-2 max-w-3xl my-10 not-prose">
    <div class="rounded-2xl surface-glass p-6 flex flex-col gap-3">
      <svg class="w-7 h-7 text-cream" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
