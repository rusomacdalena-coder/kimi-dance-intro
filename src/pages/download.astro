const WIN_FILENAME = 'Kimidance-Windows-Setup-0.4.9-r14-x64.exe'

const softwareApp = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Kimidance 积米律动',
  softwareVersion: '0.4.9',
  operatingSystem: ['macOS', 'Windows'],
  applicationCategory: 'MultimediaApplication',
  inLanguage: 'zh-CN',
  url: 'https://kimidance.com/download/',
  offers: {
