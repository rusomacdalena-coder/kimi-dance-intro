---
// 工具对比页已下架（判断层 2026-09-08 包「官网收缩第一包」B1）。
// 原页面源码保留在同目录 _ai-lapian-tools.astro（Astro 忽略下划线文件，不参与构建）与分支 compare-page-parked。
// GitHub Pages 静态托管发不出 HTTP 301，这里用 meta refresh + noindex + canonical 指向首页。
const TARGET = 'https://kimidance.com/'
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>已跳转到首页 | 积米律动</title>
    <meta http-equiv="refresh" content={`0;url=${TARGET}`} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={TARGET} />
  </head>
  <body>
    <p>本页已下架，正在跳转到<a href={TARGET}>首页</a>。</p>
  </body>
</html>
