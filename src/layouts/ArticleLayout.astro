---
import Base from './Base.astro'
import { BETA_MAILTO } from '../lib/links.mjs'

interface Props {
  title: string
  description: string
  ogImage?: string
  jsonLd?: Record<string, unknown>[]
  /** ISO date, e.g. 2026-07-05 */
  dateModified?: string
  noindex?: boolean
}

const { title, description, ogImage, jsonLd = [], dateModified, noindex = false } = Astro.props

const navLinks = [
  { label: '产出示例', href: '/#sample' },
  { label: '案例库', href: '/cases/' },
  { label: '下载', href: '/download/' },
]
---

<Base title={title} description={description} ogImage={ogImage} ogType="article" jsonLd={jsonLd} noindex={noindex}>
  <div class="min-h-screen bg-background text-foreground">
    <nav
      class="fixed top-0 inset-x-0 z-50 bg-background/95 border-b border-border"
    >
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5">
          <img src="/logo.png" alt="积米律动" class="w-8 h-8" />
          <div class="flex items-baseline gap-1.5">
            <span class="text-lg font-bold tracking-wide text-cream">积米律动</span>
            <span class="text-xs text-muted-foreground">Kimidance</span>
          </div>
        </a>
        <div class="hidden md:flex items-center gap-8">
          {
            navLinks.map((l) => (
              <a
                href={l.href}
                class="text-sm text-muted-foreground hover:text-cream transition-colors"
              >
                {l.label}
              </a>
            ))
          }
          <a href={BETA_MAILTO} class="btn-primary btn-sm">
            申请邀请码
          </a>
        </div>
        <a href={BETA_MAILTO} class="md:hidden btn-primary btn-sm">
          申请邀请码
        </a>
      </div>
    </nav>

    <main class="pt-28 pb-24 px-6 bg-warm-gradient">
      <article class="article-prose">
        <slot />
        {
          dateModified && (
            <p class="text-xs text-muted-foreground/50 mt-14">
              最后更新于 {dateModified}
            </p>
          )
        }
      </article>
    </main>

    <footer class="border-t border-border py-8 px-4 md:px-6">
      <div
        class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-muted-foreground"
      >
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href="/what-is-ai-lapian/" class="hover:text-cream transition-colors">AI 拉片</a>
          <span>·</span>
          <a href="/cases/" class="hover:text-cream transition-colors">案例库</a>
          <span>·</span>
          <a href="/download/" class="hover:text-cream transition-colors">下载</a>
          <span>·</span>
          <a href="mailto:oliverzhu929598@gmail.com" class="hover:text-cream transition-colors">oliverzhu929598@gmail.com</a>
        </div>
        <div>kimidance.com · 积米律动 · Get your hands dirty</div>
      </div>
    </footer>
  </div>
</Base>
