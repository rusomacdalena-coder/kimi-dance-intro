---
import Base from './Base.astro'
import ArticleTopNav from '../components/ArticleTopNav.astro'
import { SERVICE_OUTAGE_NOTICE, SERVICE_OUTAGE_NOTICE_CSS } from '../lib/service-outage.mjs'

interface Props {
  title: string
  description: string
  ogImage?: string
  jsonLd?: Record<string, unknown>[]
  /** ISO date, e.g. 2026-07-05 */
  dateModified?: string
  noindex?: boolean
  /** 仅下载页打开。其它文章页不渲染声明，顶栏标记保持原样。 */
  serviceOutageNotice?: boolean
}

const {
  title,
  description,
  ogImage,
  jsonLd = [],
  dateModified,
  noindex = false,
  serviceOutageNotice = false,
} = Astro.props
---

<Base title={title} description={description} ogImage={ogImage} ogType="article" jsonLd={jsonLd} noindex={noindex}>
  <div class="min-h-screen bg-background text-foreground">
    {
      serviceOutageNotice ? (
        <div class="service-outage-bar">
          <style is:inline set:html={SERVICE_OUTAGE_NOTICE_CSS} />
          <p class="service-outage-notice" role="status">
            {SERVICE_OUTAGE_NOTICE}
          </p>
          <ArticleTopNav />
        </div>
      ) : (
        <ArticleTopNav fixed />
      )
    }

    <main
      class={
        serviceOutageNotice
          ? 'service-outage-main pt-28 pb-24 px-6 bg-warm-gradient'
          : 'pt-28 pb-24 px-6 bg-warm-gradient'
      }
    >
      <article class="article-prose">
        <slot />
        {
          dateModified && (
            <p class="text-xs text-muted-foreground/50 mt-14">
              最后更新于 {dateModified}
            </p>
          )
        }
      </article>
    </main>

    <footer class="border-t border-border py-8 px-4 md:px-6">
      <div
        class="max-w-6xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-muted-foreground"
      >
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a href="/what-is-ai-lapian/" class="hover:text-cream transition-colors">AI 拉片</a>
          <span>·</span>
          <a href="/cases/" class="hover:text-cream transition-colors">案例库</a>
          <span>·</span>
          <a href="/download/" class="hover:text-cream transition-colors">下载</a>
          <span>·</span>
          <a href="mailto:oliverzhu929598@gmail.com" class="hover:text-cream transition-colors">oliverzhu929598@gmail.com</a>
        </div>
        <div>kimidance.com · 积米律动 · Get your hands dirty</div>
      </div>
    </footer>
  </div>
</Base>
